
@using Hairdresser.Areas.Admin.Models
@model List<RoleAtaViewModel>


@{
    ViewData["Title"] = "RoleAta";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h1>Role Ata</h1>

<form asp-controller="Role" asp-action="RoleAta" method="post">

    @for(int i=0;i<Model.Count;i++)
    {
        <div class="form-check">
            <input type="hidden" name="Model[@i].RoleId" value="@Model[i].RoleId" />
            <input type="hidden" name="Model[@i].rolAdi" value="@Model[i].rolAdi" />

            <input type="hidden" name="Model[@i].roleSahipMi" value="false" />
            <input type="checkbox" name="Model[@i].roleSahipMi" class="form-check-input" value="true" @(Model[i].roleSahipMi ? "checked" : "") />



@*             <input type="checkbox" asp-for="Model[@i].roleSahipMi"  class="form-check-input" value="true" @(Model[i].roleSahipMi ? "checked" : "") />
 *@

            @if(Model[i].roleSahipMi)
            {
            <input type="hidden" name="Model[@i].roleSahipMi" value="true" />  
                }
                else{
                <input type="hidden" name="Model[@i].roleSahipMi" value="false" />
                }

            <label class="form-check-label" for="@Model[@i].roleSahipMi">@Model[i].rolAdi</label>
        </div>
    }
    <br />
    <button type="submit" class="btn btn-gray" >Değişiklikleri Kaydet</button>
</form>
 
<br />
<br />

<a href="/Admin/Role/UserRoleList" class="btn btn-info">Kullanıcı Listesine Dön</a>