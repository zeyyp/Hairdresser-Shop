<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kuaför Sitesi</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet">

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.3/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.0.0/jquery.validate.unobtrusive.min.js"></script>

    <style>
        /* Genel stil */
        body {
            background-image: url('/img/arkaplan.jpg');
            background-size: cover;
            background-position: center center;
            background-repeat: no-repeat;
            height: 100vh;
        }

        /* Slider boyutları */
        .custom-slider {
            max-width: 800px; /* Slider genisligi */
            height: 200px; /* Slider yüksekliği */
            margin: 0 auto; /* Ortalama */
        }

            .custom-slider img {
                height: 200px;
                width: 100%;
                object-fit: cover; /* Görüntüyü düzgün bir şekilde kırpma */
            }

        .circle {
            width: 120px;
            height: 120px;
            background-color: #e9ecef;
            border-radius: 50%;
            margin: 0 auto 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

            .circle img {
                width: 100%;
                height: 100%;
                object-fit: fill;
            }

        .circle-text {
            font-family: 'Arial', sans-serif;
            font-size: 1.1rem;
            font-weight: bold;
            font-style: italic;
            color: #000;
            margin-top: 10px;
        }

            .circle-text:hover {
                color: #007bff;
                transform: scale(1.2);
            }

        .services {
            margin-bottom: 150px;
        }

        .footer .footer-text {
            font-size: 12px;
            line-height: 1.5;
        }

    </style>

</head>

<body>
    <!-- Header -->
    <header class="navbar navbar-expand-lg navbar-light bg-light border-bottom py-3">
        <div class="container-fluid">
            <a class="navbar-brand" href="#">Hairdresser</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                    <li class="nav-item"><a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Anasayfa</a></li>
                    <li class="nav-item"><a class="nav-link text-dark" asp-controller="Home" asp-action="bizkimiz">Biz Kimiz</a></li>
                    <li class="nav-item"><a class="nav-link text-dark" asp-controller="Home" asp-action="Hizmetler">Hizmetlerimiz</a></li>
                    <li class="nav-item"><a class="nav-link text-dark" asp-controller="Home" asp-action="İletisim">İletişim</a></li>
                    <li class="nav-item"><a class="nav-link text-dark" asp-controller="Appointment" asp-action="NewAppointment">Randevu Al</a></li>
                    <li class="nav-item"><a class="nav-link text-dark" asp-controller="Home" asp-action="YapayZekaOneri">Ai Öneri Al</a></li>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item">
                            <a class="nav-link text-dark"> Merhaba,@User.Identity.Name</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Login" asp-action="Cikis"> Çıkış Yap</a>
                        </li>

                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="Admin" asp-controller="Salon" asp-action="Index">Admin Sayfasına Dön</a>
                            </li>
                        }
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Login" asp-action="GirisYap"> Giriş Yap</a>
                        </li>
                    }

                </ul>
            </div>
        </div>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Ana İçerik -->
    <main>
        <!-- Slider -->
        <div id="modernSlider" class="carousel slide custom-slider" data-bs-ride="carousel">
            <div class="carousel-inner">
                <div class="carousel-item active">
                    <img src="~/img/salon2.jpg" class="d-block w-100" alt="Slide 1">
                </div>
                <div class="carousel-item">
                    <img src="https://via.placeholder.com/600x300" class="d-block w-100" alt="Slide 2">
                </div>
                <div class="carousel-item">
                    <img src="https://via.placeholder.com/600x300" class="d-block w-100" alt="Slide 3">
                </div>
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#modernSlider" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#modernSlider" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
            </button>
        </div>

        <!-- Hizmetler -->
        <section class="services container">
            <div class="container text-center my-5">
                <div class="row">
                    <div class="col-md-3">
                        <a asp-action="Hizmetler" asp-controller="Home">
                            <div class="circle">
                                <img src="~/img/sackesimi.jpg" alt="Saç Kesimi" class="img-fluid">
                            </div>
                            <p class="circle-text">Saç Kesimi</p>
                        </a>
                    </div>
                    <div class="col-md-3">
                        <a asp-action="Hizmetler" asp-controller="Home">
                            <div class="circle">
                                <img src="~/img/sacboyama.jpg" alt="Saç Boyama" class="img-fluid">
                            </div>

                            <p class="circle-text">Saç Boyama</p>
                        </a>
                    </div>
                    <div class="col-md-3">
                        <a asp-action="Hizmetler" asp-controller="Home">
                            <div class="circle">
                                <img src="~/img/makyaj.webp" alt="Makyaj" class="img-fluid">
                            </div>
                            <p class="circle-text">Makyaj</p>
                        </a>
                    </div>
                    <div class="col-md-3">
                        <a asp-action="Hizmetler" asp-controller="Home">
                            <div class="circle">
                                <img src="~/img/manikür.webp" alt="Manikür" class="img-fluid">
                            </div>
                            <p class="circle-text">Manikür</p>
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <!-- Footer -->
        <footer class="footer">
            <div class="container text-center">
                <h5>Hairdresser</h5>
                <p class="footer-text">
                    <strong>Adres:</strong> Ergenekon Mahallesi Nilüfer Sokak KulePark 2/C, Yenişehir, Ankara <br>
                    <strong>Çalışma Saatleri:</strong> 09:00 – 18:00
                </p>
            </div>
        </footer>
    </main>

    @RenderSection("Scripts", required: false)
    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>