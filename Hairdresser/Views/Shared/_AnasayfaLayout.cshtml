

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kuaför Sitesi</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet">

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.3/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.0.0/jquery.validate.unobtrusive.min.js"></script>

    <style>
        /* Ek stil */
        body {
            background-image: url('/img/arkaplan.jpg'); /* Doğru yol */
            background-size: cover;
            background-position: center center;
            background-repeat: no-repeat;
            height: 100vh;
        }

        
        .slider {
            background-color: #f8f9fa;
            height: 300px;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 24px;
            font-weight: bold;
            color: #6c757d;
            margin-bottom: 30px;
        }

        .circle {
            width: 120px;
            height: 120px;
            background-color: #e9ecef;
            border-radius: 50%;
            margin: 0 auto 15px;
            display: flex;
            align-items: center; /* Resmi dikey ortalar */
            justify-content: center; /* Resmi yatay ortalar */
            overflow: hidden; /* Taşan kısmı gizler */
        }

            .circle img {
                width: 100%; /* Resmin genişliği çemberin içine uyar */
                height: 100%; /* Resmin yüksekliği çemberin içine uyar */
                object-fit: fill; /* Resmi çerçeveye tam olarak doldurur, orijinal oranları bozar */
            }

        .services {
            margin-bottom: 150px; /* Hizmetler bölümünün altında 50px boşluk */
        }

        .service p {
            font-size: 16px;
            font-weight: bold;
        }

        .footer .footer-text {
            font-size: 12px; /* Yazı boyutu */
            line-height: 1.5; /* Satır arası boşluk */
        }

    </style>

</head>



<body>
    <!-- Header -->
    <header class="bg-light border-bottom py-3">
        <div class="container d-flex justify-content-between align-items-center">
            <div class="logo h4 mb-0">Hairdresser</div>
            <nav>
                <ul class="nav">
                    <li class="nav-item"><a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Anasayfa</a></li>
                    <li class="nav-item"><a class="nav-link text-dark" asp-controller="Home" asp-action="bizkimiz">Biz Kimiz</a></li>
                    <li class="nav-item"><a class="nav-link text-dark" asp-controller="Home" asp-action="Hizmetler">Hizmetlerimiz</a></li>
                    <li class="nav-item"><a class="nav-link text-dark" asp-controller="Home" asp-action="İletisim">İletişim</a></li>
                    <li class="nav-item"><a class="nav-link text-dark" asp-controller="Appointment" asp-action="NewAppointment">Randevu Al</a></li>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item">
                            <a class="nav-link text-dark"> Merhaba,@User.Identity.Name</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Login" asp-action="Cikis"> Çıkış Yap</a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Login" asp-action="GirisYap"> Giriş Yap</a>
                        </li>
                    }

                </ul>
            </nav>
        </div>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Ana İçerik -->
    <main>
        <!-- Slider -->
        <div class="slider">
            <p>Slider</p>
        </div>

        <!-- Hizmetler -->
        <section class="services container">
            <div class="container text-center my-5">
                <div class="row">
                    <div class="col-md-3">
                        <a asp-action="Hizmetler" asp-controller="Home">
                        <div class="circle">
                            <img src="~/img/sackesimi.jpg" alt="Saç Kesimi" class="img-fluid">
                        </div>   
                        <p>Saç Kesimi</p>
                        </a>
                    </div>
                    <div class="col-md-3">
                        <a asp-action="Hizmetler" asp-controller="Home">
                        <div class="circle">
                            <img src="~/img/sacboyama.jpg" alt="Saç Boyama" class="img-fluid">
                        </div>
    
                        <p>Saç Boyama</p>
                        </a>
                    </div>
                    <div class="col-md-3">
                        <a asp-action="Hizmetler" asp-controller="Home">
                        <div class="circle">
                            <img src="~/img/makyaj.webp" alt="Makyaj" class="img-fluid">
                        </div>
                        <p>Makyaj</p>
                        </a>
                    </div>
                    <div class="col-md-3">
                        <a asp-action="Hizmetler" asp-controller="Home">
                        <div class="circle">
                            <img src="~/img/manikür.webp" alt="Manikür" class="img-fluid">
                        </div>
                        <p>Manikür</p>
                        </a>
                    </div>
                </div>
            </div>
        </section>





        

        <!-- Footer -->
        <footer class="footer">
            <div class="container text-center">
                <h5>Hairdresser</h5>
                <p class="footer-text">
                    <strong>Adres:</strong> Ergenekon Mahallesi Nilüfer Sokak KulePark 2/C, Yenişehir, KARABÜK <br>
                    <strong>Çalışma Saatleri:</strong> 09:00 – 18:00
                </p>
            </div>
        </footer>

    </main>


    @RenderSection("Scripts", required: false)
    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
