@model Hairdresser.Models.GirisYapViewModel

@{
    ViewData["Title"] = "Giris yap";
    Layout = "_Layout";
}



<div class="d-flex justify-content-center align-items-center vh-100">
    <div class="card p-4" style="min-width: 300px;">
        <h2 class="text-center">@ViewData["Title"]</h2>


<form asp-action="GirisYap" method="post">
    

    <div class="form-group">
        <label asp-for="Email" class="control-label"></label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="sifre" class="control-label"></label>
        <input asp-for="sifre" class="form-control" type="password" />
        <span asp-validation-for="sifre" class="text-danger"></span>
    </div>

    <br />
            <div class="text-center mt-3">
            <button type="submit" class="btn btn-pink text-white" style="background-color: pink;" > Giris Yap</button>
            </div>

</form>

<br />


        <div class=" mt-3">
            <a asp-action="KayitOl" class="text-decoration-none">--> Yeni kullanıcıysanız kayıt</a>
        </div>
    </div>
</div>