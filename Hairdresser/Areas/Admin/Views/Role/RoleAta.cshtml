
@using Hairdresser.Areas.Admin.Models
@model RoleAtaViewModel


@{
    ViewData["Title"] = "RoleAta";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h1>Role Ata</h1>

<form asp-controller="Role" asp-action="RoleAta" method="post">

    <input name="Id" type="hidden" value="@Model.Id"/>  @* //kullanıcının user ıdsi *@

   <div class="card">
       <div class="card-body">
           @foreach(var role in ViewBag.Roles){
               <div class="form-check" >
                    <input type="checkbox" class="form-check-input" id="@role"
                           name="selectedRoles" value="@role" @(Model.selectedRoles.Any(i => i == role) ? "checked" : "")>
                    <label for="@role" class="form-check-label">@role</label>
               </div>
           }
       </div>
   </div>
   

    <br /> 


    <button type="submit" class="btn btn-gray" >Değişiklikleri Kaydet</button>
</form>
 
<br />
<br />

<a href="/Admin/Role/UserRoleList" class="btn btn-info">Kullanıcı Listesine Dön</a>


